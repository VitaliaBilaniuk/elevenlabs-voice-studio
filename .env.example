# Copy to .env and fill in. .env is gitignored.

# Required. Create one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Port the proxy server listens on (default 8787).
API_PORT=8787

# Optional. MongoDB connection string for clip history (GraphQL at
# /api/graphql). Defaults to a local MongoDB on the standard port.
# Synthesis works fine without this — only the history feature needs it.
MONGODB_URI=mongodb://127.0.0.1:27017/voice-studio
